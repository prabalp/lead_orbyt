# Copy this file to `.env` (same directory leadorbyt.db lives in -- wherever
# you run `leadorbyt`/`leadorbyt-admin` from) and fill in whichever keys you
# actually have. Every field below is read once, at startup, by config.py.
#
# A source with a blank key here is simply never called -- see
# leadorbyt/sources/registry.py for exactly which fields each one adds and
# leadorbyt/sources/<name>.py for its docs link. Nothing needs every key
# filled in; the pipeline runs fine with zero of these set (it just skips
# straight to Google Maps discovery + website enrichment, as before).

# --- HTTP transport (multi-tenant server) ---
LEADORBYT_PUBLIC_URL=http://127.0.0.1:8000
LEADORBYT_SIGNUP_ENABLED=true
LEADORBYT_SIGNUP_PER_HOUR=8

# Transactional email for the signup verification link (same env names as Mail Orbyt).
# Get a key at https://resend.com/api-keys. Leave RESEND_API_KEY blank to log
# the message instead of sending it (local dev). The from address must be on a
# domain verified in Resend for production.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Lead Orbyt <onboarding@resend.dev>

# --- Pre-enrichment qualification gate (see leadorbyt/qualify.py) ---
LEADORBYT_REQUIRE_WEBSITE_FOR_EXTRAS=true
LEADORBYT_EXCLUDE_CATEGORIES=

# --- ML lead qualification against a caller-supplied ICP (see leadorbyt/qualify_ml.py) ---
# No API key here, ever: qualification is a fully offline confidence gate
# learned from verdicts the calling MCP agent supplies via
# submit_lead_verdicts (see list_unlabeled_leads/submit_lead_verdicts in
# server.py). Until enough verdicts exist, find_leads(icp=...)/
# find_people_leads(icp=...) report every lead qualified=True/
# source=agent_pending rather than dropping it.
LEADORBYT_QUALIFY_MIN_LABELS=8
LEADORBYT_QUALIFY_GATE_CONFIDENCE=0.85
LEADORBYT_QUALIFY_GATE_MAX_STD=0.15

# --- Person-lead discovery spend guardrail (see leadorbyt/people_jobs.py) ---
# Hard server-side ceiling on find_people_leads'/submit_people_search's
# max_paid_lookups, enforced regardless of what a caller requests.
LEADORBYT_MAX_PAID_LOOKUPS_CEILING=50

# --- Person-lead discovery providers (see leadorbyt/sources/person_search.py) ---
# BetterContact is used when set (its free search includes full name,
# LinkedIn URL, and company domain -- Apollo's free tier withholds all
# three). Apollo is the fallback when this is blank.
BETTERCONTACT_API_KEY=

# --- Places / local business data ---
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
# OpenStreetMap/Overpass needs no key; override the endpoint only if you run your own instance.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Corporate / firmographic data ---
# SEC EDGAR is free/keyless but requires an identifying User-Agent, e.g. "Jane Doe jane@example.com"
SEC_EDGAR_USER_AGENT=
# OpenCorporates works keyless at low volume; a key just raises the rate limit.
OPENCORPORATES_API_KEY=
CRUNCHBASE_API_KEY=
CLEARBIT_API_KEY=

# --- Tech stack detection ---
BUILTWITH_API_KEY=
WAPPALYZER_API_KEY=
# Shopify/WooCommerce detection is a free HTML check -- no key, always runs.

# --- Job boards ---
# Greenhouse/Lever/Ashby need no global key (public per-company boards).
THEMUSE_API_KEY=

# --- News / social ---
NEWSAPI_ORG_API_KEY=
X_BEARER_TOKEN=

# --- Contact / people enrichment ---
HUNTER_API_KEY=
APOLLO_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
ROCKETREACH_API_KEY=
PEOPLEDATALABS_API_KEY=
LUSHA_API_KEY=
COGNISM_API_KEY=
# ZoomInfo uses a signed-JWT exchange, not a plain key -- see leadorbyt/sources/zoominfo.py.
ZOOMINFO_USERNAME=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=
FINDYMAIL_API_KEY=
LEADMAGIC_API_KEY=
WIZA_API_KEY=
PROSPEO_API_KEY=

# --- Not integrated (no public self-serve API; see leadorbyt/sources/indeed.py and .../linkedin.py) ---
INDEED_PUBLISHER_ID=
LINKEDIN_API_KEY=
